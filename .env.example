# Copy this file to .env before running docker compose.
# .env is gitignored — never commit real secrets.

POSTGRES_PASSWORD=devpassword

# Comma-separated stock tickers the pipeline ingests
TICKERS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Dev-only Airflow webserver secret key (fine for local learning, never for production)
AIRFLOW_WEBSERVER_SECRET_KEY=dev-secret-key-change-me

AIRFLOW_UID=50000
